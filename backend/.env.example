# Copie este arquivo para .env  ->  cp .env.example .env
# Se voce subiu o banco pelo docker compose, pode deixar exatamente como esta.

DATABASE_URL=postgresql+psycopg://barbearia:barbearia@localhost:5435/barbearia

# Banco usado só pelos testes do pytest (nao mexe no banco de verdade).
# Se este banco nao existir, os testes caem automaticamente para SQLite.
TEST_DATABASE_URL=postgresql+psycopg://barbearia:barbearia@localhost:5435/barbearia_teste

# De onde o front pode chamar a API (o Next roda na 3020 — a 3000 e a 3010 já estavam ocupadas na minha máquina)
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
